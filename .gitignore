# Hugo build output
/public/
/resources/_gen/
/hugo_stats.json
.hugo_build.lock

# Old backup site (if used)
/!oldsite/

# Build artifacts
*.bak
*.tmp
*.swp
*.swo

# Node.js dependencies (if using npm/yarn for asset pipelines)
node_modules/

# Private local notes / personal to-do (never publish)
/.notes/

# OS / Editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
.vscode/launch.json
.vscode/*.log
*.code-workspace
*.log
todo.md

# Netlify / deployment folders (if you generate them locally)
.netlify/

# Hugo environment files (if you have any secrets stored here)
.env
.env.*

# Other potential caches and artifacts
.cache/
.hugo_cache/

# Optional Hugo archetypes (ignore if not using `hugo new`)
archetypes/

# VS Code workspace recommendations and local extensions
.vscode/extensions.json
.vscode/extensions/